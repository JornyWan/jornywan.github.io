---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.22}}px, (min-width: 576px)
      22vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        <!-- Social icons, right underneath the profile photo -->
        {% if page.social %}
          <div class="profile-social">{% include social.liquid %}</div>
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>News</h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>latest posts</h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <div class="section-heading">
        <h2>Publications</h2>
        <div class="pub-toggle">
          <button id="btn-selected" class="btn btn-pub active" onclick="togglePubs('selected')">Selected</button>
          <button id="btn-full" class="btn btn-pub" onclick="togglePubs('full')">Full List</button>
        </div>
      </div>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Experience -->
    <h2>Experience</h2>
    <div class="experience">
      <div class="exp-item">
        <img class="exp-logo" src="{{ '/assets/img/adobe_logo.svg' | relative_url }}" alt="Adobe" width="24" height="24">
        <div class="exp-body">
          <div class="exp-head">
            <span class="exp-role">Research Intern</span>
            <span class="exp-org">Adobe (Firefly)</span>
            <span class="exp-date">May 2026 &ndash; Aug 2026</span>
          </div>
          <ul class="exp-points">
            <li>
              <strong>Large-scale pre-training</strong> of Firefly foundation models: data curricula and mixture pipelines over
              billions of image/video samples; profiled multi-node training bottlenecks to refine training recipes.
            </li>
            <li>
              <strong>Post-training</strong> for image generation with on-policy distillation (OPD) and reinforcement learning.
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Awards & Honors -->
    <h2>Awards &amp; Honors</h2>
    <ul class="dated-list">
      <li>
        <span><strong>CVPR NTIRE</strong> Efficient Super-Resolution Challenge &mdash; 1st place &amp; Oral</span>
        <span class="dated-list-date">2024</span>
      </li>
      <li>
        <span><strong>CVPR NTIRE</strong> Image Super-Resolution (&times;4) Challenge &mdash; 1st place</span>
        <span class="dated-list-date">2024</span>
      </li>
      <li>
        <span><strong>CVPR NTIRE</strong> Raw Image Super-Resolution Challenge &mdash; 2nd place</span>
        <span class="dated-list-date">2024</span>
      </li>
      <li>
        <span><strong>CVPR NTIRE</strong> Efficient Super-Resolution Challenge &mdash; 2nd place</span>
        <span class="dated-list-date">2025</span>
      </li>
      <li>
        <span><strong>ICCV VOTS</strong> Challenge, Robustness Track &mdash; 3rd place</span>
        <span class="dated-list-date">2023</span>
      </li>
      <li>
        <span>Cornell Ph.D. Fellowship</span>
        <span class="dated-list-date">2024 &ndash; 2025</span>
      </li>
      <li>
        <span>Merit Student Scholarship, Georgia Tech</span>
        <span class="dated-list-date">2022 &ndash; 2023</span>
      </li>
      <li>
        <span>Outstanding Scholarship (Top 1), Nanchang Hangkong University</span>
        <span class="dated-list-date">2021 &ndash; 2022</span>
      </li>
      <li>
        <span>Outstanding Scholarship (Top 10), Nanchang Hangkong University</span>
        <span class="dated-list-date">2020 &ndash; 2021</span>
      </li>
    </ul>

    <!-- Academic Service -->
    <h2>Academic Service</h2>
    <p class="service">
      <strong>Reviewer</strong>: NeurIPS (2024&ndash;2026), ICLR (2025&ndash;2026), ICML (2025), AISTATS (2025&ndash;2026)<br>
      <strong>Workshop Reviewer</strong>: NeurIPS AI4Science (2025&ndash;2026), NeurIPS SPIGM (2025&ndash;2026), ICML AI4Science
      (2024)
    </p>

    <!-- Teaching -->
    <h2>Teaching</h2>
    <ul class="dated-list">
      <li>
        <span>
          <strong>Teaching Assistant (Co-lecturer)</strong>, ECE 5200/3200: Foundations of Machine Learning, Cornell
          University
        </span>
        <span class="dated-list-date">Spring 2025</span>
      </li>
    </ul>

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
